{% load static %}{
  "name": "Daily Signal",
  "short_name": "Signal",
  "description": "A no-BS daily transit dashboard: energy, focus, friction.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#12161C",
  "theme_color": "#1F3A5F",
  "icons": [
    {
      "src": "{% static 'horoscope/icons/icon-192.png' %}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "{% static 'horoscope/icons/icon-512.png' %}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
